{
    "id": "ws-gpu-pytorch-check-grasping",
    "version": "1",
    "name": "GPU PyTorch check (grasping)",
    "category": "Simulation",
    "icon": "code",
    "side": "backend",
    "customizable": true,
    "summary": "Checks which CUDA build of PyTorch runs on this worker's NVIDIA GPU (for the conveyor grasping block).",
    "help": "",
    "inputs": [],
    "outputs": [],
    "params": [
        {
            "key": "spec",
            "label": "Torch spec",
            "type": "text",
            "default": "torch==2.14.1"
        },
        {
            "key": "cu",
            "label": "CUDA index",
            "type": "text",
            "default": "cu126"
        },
        {
            "key": "install",
            "label": "Install",
            "type": "select",
            "default": "No",
            "options": [
                "No",
                "Yes",
                "Remove"
            ]
        }
    ],
    "hardware": [
        "nvidia"
    ],
    "esasim": {
        "version": 2
    }
}
